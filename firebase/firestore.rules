rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function hasAdminProfile() {
      return signedIn() && exists(adminPath());
    }

    function adminProfile() {
      return get(adminPath()).data;
    }

    function superAdminAccessPath() {
      return /databases/$(database)/documents/superAdminAccess/$(request.auth.uid);
    }

    function hasActiveSuperAdminAccess() {
      return signedIn()
        && exists(superAdminAccessPath())
        && get(superAdminAccessPath()).data.active == true;
    }

    function activeStatus(status) {
      return status == "active" || status == "ACTIVE";
    }

    function isSuperAdmin() {
      return hasActiveSuperAdminAccess();
    }

    function isInstituteAdmin() {
      return hasAdminProfile()
        && activeStatus(adminProfile().status)
        && adminProfile().role in ["admin", "ADMIN"];
    }

    function hasPermission(permission) {
      return isSuperAdmin()
        || (isInstituteAdmin()
          && (
            (adminProfile().permissions is list
              && adminProfile().permissions.hasAny([permission]))
            || (adminProfile().permissionMode == "EXAM_MANAGER"
              && permission in [
                "dashboard.view", "exam.view", "exam.create", "exam.edit",
                "exam.control", "batch.manage", "question.view",
                "question.create", "question.edit", "question.delete",
                "candidate.view", "candidate.manage", "result.view",
                "result.export", "feedback.view", "security.view"
              ])
          ));
    }

    function managesInstitute(instituteId) {
      return isSuperAdmin()
        || (isInstituteAdmin()
          && adminProfile().instituteIds is list
          && adminProfile().instituteIds.hasAny([instituteId]));
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function createsOwnedDocument() {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.instituteId is string
        && request.resource.data.instituteId.size() > 0;
    }

    function preservesOwnership() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.instituteId == resource.data.instituteId;
    }

    function migratesVerifiedCandidateInstitute() {
      return signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && resource.data.status == "verified"
        && request.resource.data.status == "verified"
        && request.resource.data.instituteId is string
        && request.resource.data.instituteId.size() > 0
        && exists(
          /databases/$(database)/documents/institutes/$(request.resource.data.instituteId)
        )
        && activeStatus(
          get(
            /databases/$(database)/documents/institutes/$(request.resource.data.instituteId)
          ).data.status
        );
    }

    function managesResourceInstitute() {
      return resource.data.instituteId is string
        && managesInstitute(resource.data.instituteId);
    }

    function managesRequestedInstitute() {
      return request.resource.data.instituteId is string
        && managesInstitute(request.resource.data.instituteId);
    }

    function candidatePath() {
      return /databases/$(database)/documents/candidates/$(request.auth.uid);
    }

    function candidateCanReadQuestion() {
      return signedIn()
        && exists(candidatePath())
        && get(candidatePath()).data.status == "active"
        && get(candidatePath()).data.examId is string
        && resource.data.examIds is list
        && resource.data.examIds.hasAny([get(candidatePath()).data.examId]);
    }

    match /admins/{adminId} {
      allow get: if signedIn()
        && (request.auth.uid == adminId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    // Platform-owner allowlist. Bootstrap entries are created only from the
    // trusted Firebase Console. An active Super Admin may maintain them later.
    match /superAdminAccess/{adminId} {
      allow get: if signedIn()
        && (request.auth.uid == adminId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    match /institutes/{instituteId} {
      allow read: if isSuperAdmin()
        || (isInstituteAdmin() && managesInstitute(instituteId))
        || resource.data.status == "ACTIVE";
      allow create, update, delete: if isSuperAdmin();
    }

    match /portalConfigs/{configId} {
      allow read: if isSuperAdmin()
        || (isInstituteAdmin() && managesResourceInstitute())
        || resource.data.status == "PUBLISHED";
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /exams/{examId} {
      allow read: if isSuperAdmin()
        || (isInstituteAdmin() && managesResourceInstitute())
        || (signedIn() && resource.data.status in ["LIVE", "SCHEDULED"]);
      allow create: if hasPermission("exam.create")
        && managesRequestedInstitute();
      allow update: if (hasPermission("exam.edit")
          && managesResourceInstitute()
          && managesRequestedInstitute())
        || (hasPermission("question.create")
          && managesResourceInstitute()
          && managesRequestedInstitute()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "questionIds",
            "updatedAt",
            "updatedBy"
          ]));
      allow delete: if hasPermission("exam.delete")
        && managesResourceInstitute();
    }

    match /batches/{batchId} {
      allow read: if isSuperAdmin()
        || (isInstituteAdmin() && managesResourceInstitute());
      allow create: if hasPermission("batch.manage")
        && managesRequestedInstitute();
      allow update: if hasPermission("batch.manage")
        && managesResourceInstitute()
        && managesRequestedInstitute();
      allow delete: if hasPermission("batch.manage")
        && managesResourceInstitute();
    }

    match /questions/{questionId} {
      allow get: if isSuperAdmin()
        || (isInstituteAdmin() && managesResourceInstitute())
        || candidateCanReadQuestion();
      allow list: if isSuperAdmin()
        || (isInstituteAdmin() && managesResourceInstitute());
      allow create: if hasPermission("question.create")
        && managesRequestedInstitute();
      allow update: if hasPermission("question.edit")
        && managesResourceInstitute()
        && managesRequestedInstitute();
      allow delete: if hasPermission("question.delete")
        && managesResourceInstitute();
    }

    // Legacy question bank used by the current Candidate portal. Candidate
    // reads remain necessary until question delivery moves to a trusted
    // backend that can withhold correct answers.
    match /questionBank/{questionId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /examSettings/{settingsId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /candidates/{candidateId} {
      allow get: if isSuperAdmin()
        || (signedIn() && request.auth.uid == candidateId)
        || ownsExistingDocument()
        || (isInstituteAdmin() && managesResourceInstitute());
      allow list: if isSuperAdmin()
        || (isInstituteAdmin()
          && hasPermission("candidate.view")
          && managesResourceInstitute());
      allow create: if createsOwnedDocument()
        && request.auth.uid == candidateId;
      allow update: if (ownsExistingDocument()
          && (preservesOwnership() || migratesVerifiedCandidateInstitute()))
        || isSuperAdmin()
        || (isInstituteAdmin()
          && hasPermission("candidate.manage")
          && managesResourceInstitute()
          && managesRequestedInstitute());
      allow delete: if isSuperAdmin()
        || (isInstituteAdmin()
          && hasPermission("candidate.manage")
          && managesResourceInstitute());
    }

    match /attempts/{attemptId} {
      allow get: if isSuperAdmin()
        || ownsExistingDocument()
        || (isInstituteAdmin() && managesResourceInstitute());
      allow list: if isSuperAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (isInstituteAdmin()
          && hasPermission("candidate.view")
          && managesResourceInstitute());
      allow create: if createsOwnedDocument()
        && request.resource.data.status == "active";
      allow update: if (ownsExistingDocument() && preservesOwnership())
        || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /candidateLocks/{lockId} {
      allow get: if signedIn() || isSuperAdmin();
      allow list: if isSuperAdmin()
        || (isInstituteAdmin() && hasPermission("candidate.view") && managesResourceInstitute());
      allow create: if createsOwnedDocument()
        && request.resource.data.examId is string
        && request.resource.data.status == "active";
      allow update: if (ownsExistingDocument() && preservesOwnership()) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /results/{resultId} {
      allow get: if isSuperAdmin()
        || ownsExistingDocument()
        || (isInstituteAdmin()
          && hasPermission("result.view")
          && managesResourceInstitute());
      allow list: if isSuperAdmin()
        || (isInstituteAdmin()
          && hasPermission("result.view")
          && managesResourceInstitute());
      allow create: if createsOwnedDocument();
      allow update, delete: if isSuperAdmin();
    }

    match /violations/{violationId} {
      allow get: if isSuperAdmin()
        || ownsExistingDocument()
        || (isInstituteAdmin()
          && hasPermission("security.view")
          && managesResourceInstitute());
      allow list: if isSuperAdmin()
        || (isInstituteAdmin()
          && hasPermission("security.view")
          && managesResourceInstitute());
      allow create: if createsOwnedDocument();
      allow update, delete: if isSuperAdmin();
    }

    match /securityEvents/{eventId} {
      allow read, write: if isSuperAdmin();
    }

    match /securityPolicies/{policyId} {
      allow read: if isSuperAdmin()
        || (isInstituteAdmin() && managesResourceInstitute())
        || (signedIn() && resource.data.status == "PUBLISHED");
      allow create, update, delete: if isSuperAdmin();
    }

    match /securityPolicyVersions/{versionId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if createsOwnedDocument();
      allow read: if isSuperAdmin()
        || (isInstituteAdmin()
          && hasPermission("feedback.view")
          && managesResourceInstitute());
      allow update, delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isInstituteAdmin()
          && request.resource.data.adminId == request.auth.uid
          && managesRequestedInstitute());
      allow update, delete: if false;
    }

    match /globalSettings/{settingId} {
      allow read: if isSuperAdmin() || settingId == "emergency";
      allow create, update, delete: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || (signedIn()
          && exists(candidatePath())
          && resource.data.status == "PENDING"
          && resource.data.examId == get(candidatePath()).data.examId
          && resource.data.type in ["FORCE_SUBMIT_EXAM", "FORCE_SUBMIT_CANDIDATE"]
          && (resource.data.candidateId == null
            || resource.data.candidateId == request.auth.uid));
      allow create, update, delete: if isSuperAdmin();
    }

    match /presence/{presenceId} {
      allow get, list: if isSuperAdmin()
        || (isInstituteAdmin()
          && hasPermission("candidate.view")
          && managesResourceInstitute())
        || (signedIn() && request.auth.uid == presenceId);
      allow create: if createsOwnedDocument()
        && request.auth.uid == presenceId;
      allow update: if ownsExistingDocument()
        && request.auth.uid == presenceId
        && preservesOwnership();
      allow delete: if isSuperAdmin()
        || (signedIn() && request.auth.uid == presenceId);
    }

    match /authorizedAdmins/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
